# Telegram bot token from @BotFather
BOT_TOKEN=123456:REPLACE_ME

# Private admin-only chat where approve/reject cards are posted (NOT a supergroup topic —
# topics are visible to all group members and can't be hidden from regular users).
ADMIN_CHAT_ID=

# The student community supergroup and its forum topics (message_thread_id).
# Leave topic IDs blank until Phase 2/announcements features need them.
GROUP_CHAT_ID=
TOPIC_ANNOUNCEMENTS_ID=
TOPIC_AFISHA_ID=
TOPIC_VOTING_ID=

# Postgres (values here must match what's passed to the postgres service in docker-compose.yml)
POSTGRES_USER=ttc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ttc
DATABASE_URL=postgresql+asyncpg://ttc:change_me@postgres:5432/ttc

# Redis (FSM storage)
REDIS_URL=redis://redis:6379/0