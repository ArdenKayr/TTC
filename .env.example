# Telegram bot token from @BotFather
BOT_TOKEN=123456:REPLACE_ME

# Admin chat: a separate forum supergroup. Request cards go to the applications
# topic (empty = the General topic); reports and admin calls go to the reports topic.
# The bot needs the "Delete messages" admin right there (it removes service messages).
# ADMIN_CHAT_ID is its -100... id; topic ids are the message_thread_id of each topic
# (the number at the end of the topic link, e.g. t.me/your_chat/5 -> 5).
ADMIN_CHAT_ID=-1004492113804
ADMIN_TOPIC_APPLICATIONS_ID=3
ADMIN_TOPIC_REPORTS_ID=5

# Community supergroup: numeric -100... id or public @username (resolved at startup).
# The bot deletes service messages (joins, leaves etc.) and enforces read-only topics
# (announcements, afisha), so it needs the "Delete messages" admin right here too.
# Топик «Флуд» — свободное общение; вызов админов (/admin, @admin) работает в любом топике.
GROUP_CHAT_ID=@The_True_Course_SPB
TOPIC_ANNOUNCEMENTS_ID=2
TOPIC_AFISHA_ID=6
TOPIC_VOTING_ID=8

# Postgres (values here must match what's passed to the postgres service in docker-compose.yml)
POSTGRES_USER=ttc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ttc
DATABASE_URL=postgresql+asyncpg://ttc:change_me@postgres:5432/ttc

# Redis (FSM storage)
REDIS_URL=redis://redis:6379/0
