# Telegram bot token from @BotFather
BOT_TOKEN=123456:REPLACE_ME

# Admin chat: a separate forum supergroup. Request cards go to the applications
# topic (empty = the General topic); reports and admin calls go to the reports topic.
# The bot needs the "Delete messages" admin right there (it removes service messages).
# ADMIN_CHAT_ID is its -100... id; topic ids are the message_thread_id of each topic
# (the number at the end of the topic link, e.g. t.me/your_chat/5 -> 5).
ADMIN_CHAT_ID=-1004492113804
ADMIN_TOPIC_APPLICATIONS_ID=3
ADMIN_TOPIC_REPORTS_ID=5

# Community supergroup: numeric -100... id (a public @username also works, if there is one).
# The bot deletes service messages (joins, leaves etc.) and enforces read-only topics
# (announcements, afisha), so it needs the "Delete messages" admin right here too.
# Топик «Флуд» — свободное общение; вызов админов (/admin, @admin) работает в любом топике.
#
# Группа закрытая: публичного имени у неё нет, вступают только по ссылке от бота.
# Поэтому здесь нужен именно номер, а узнать его можно так: написать в группе /id —
# бот ответит номером чата и номером темы. Тем же способом берутся и номера топиков.
# Бот должен быть админом с правом «Приглашать пользователей по ссылке»: без него
# закрытая группа заперта наглухо, и он предупредит об этом в журнале при запуске.
GROUP_CHAT_ID=-1001234567890
TOPIC_ANNOUNCEMENTS_ID=2
TOPIC_AFISHA_ID=6
TOPIC_VOTING_ID=8

# Каким протоколом бот ходит в Telegram: auto | ipv6 | ipv4.
#
# auto (по умолчанию) — как решит система: сначала IPv6, при неудаче IPv4.
# Годится почти везде, но не на боевом сервере: с него api.telegram.org
# доступен только по IPv6, а запрос по IPv4 не отвергается, а молча висит.
# Поэтому на сервере стоит ipv6 — тогда вместо минутного ожидания в никуда
# бот сразу получает отказ и повторяет запрос.
#
# Если однажды пропадёт IPv6, а IPv4 заработает — поменяйте на auto и
# перезапустите бота. Проверить, что происходит со связью прямо сейчас:
#   docker exec ttc-bot-1 python /app/scripts/net_watch.py once
TELEGRAM_IP_FAMILY=auto

# Postgres (values here must match what's passed to the postgres service in docker-compose.yml)
POSTGRES_USER=ttc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ttc
DATABASE_URL=postgresql+asyncpg://ttc:change_me@postgres:5432/ttc

# Redis (FSM storage)
REDIS_URL=redis://redis:6379/0
