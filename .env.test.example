# Настройки ТЕСТОВОГО контура. Кладутся на сервер как /opt/ttc-test/.env
# (именно .env — compose ищет файл с этим именем в своей папке).
#
# Правило одно: здесь не должно быть ни одного боевого значения. Другой бот,
# другие чаты, другой пароль базы. Если в ENV_NAME стоит test, а чаты боевые,
# бот откажется запускаться — см. bot/config.py.

# Контур. Из-за этой строки бот пишет в логи «ТЕСТОВЫЙ КОНТУР» и проверяет,
# что не подключён к боевым чатам.
ENV_NAME=test

# Токен ВТОРОГО бота от @BotFather (не боевого!).
BOT_TOKEN=123456:REPLACE_ME

# Тестовый чат админов — отдельная форум-супергруппа. Номера тем берутся из
# ссылки на тему: t.me/c/1234567890/5 -> 5.
ADMIN_CHAT_ID=-100REPLACE_ME
ADMIN_TOPIC_APPLICATIONS_ID=
ADMIN_TOPIC_REPORTS_ID=

# Тестовая группа сообщества — тоже отдельная, с темами «Объявления», «Афиша»,
# «Голосование». Пустое значение = тема не заведена, проверка топика не работает.
GROUP_CHAT_ID=-100REPLACE_ME
TOPIC_ANNOUNCEMENTS_ID=
TOPIC_AFISHA_ID=
TOPIC_VOTING_ID=

# База тестового контура. Пароль свой, не боевой: базы разные, данные не
# пересекаются, тестировщики могут ломать что угодно.
POSTGRES_USER=ttc
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=ttc
DATABASE_URL=postgresql+asyncpg://ttc:REPLACE_ME@postgres:5432/ttc

REDIS_URL=redis://redis:6379/0
